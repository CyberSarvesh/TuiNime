# Maintainer: Sarvesh Mohite
# AUR package "tuinime-bin": installs the prebuilt binary from the GitHub Release.
# After a release: bump pkgver, run `updpkgsums`, then `makepkg --printsrcinfo > .SRCINFO`.
pkgname=tuinime-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Browse and stream anime from your terminal: posters, search, episode lists, and playback in mpv"
arch=('x86_64' 'aarch64')
url="https://github.com/CyberSarvesh/TuiNime"
license=('MIT')
depends=('mpv' 'gcc-libs' 'glibc')
provides=('tuinime')
conflicts=('tuinime')
source_x86_64=("$url/releases/download/v$pkgver/tuinime-x86_64-unknown-linux-gnu.tar.xz")
source_aarch64=("$url/releases/download/v$pkgver/tuinime-aarch64-unknown-linux-gnu.tar.xz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    # dist's tarballs unpack into a folder named after the archive
    [ -d "tuinime-$CARCH-unknown-linux-gnu" ] && cd "tuinime-$CARCH-unknown-linux-gnu"
    install -Dm755 tuinime "$pkgdir/usr/bin/tuinime"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
